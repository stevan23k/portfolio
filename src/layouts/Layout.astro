---
import { TooltipProvider } from "@/components/ui/tooltip";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Esteban Van-strahlen</title>
  </head>

  <div class="pointer-events-none fixed mix-blend-difference inset-0 z-0 bg-[radial-gradient(#334155_1px,transparent_1px)] [background-size:60px_60px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)]" />
  <body class="z-10">
    <TooltipProvider>
      <slot />
    </TooltipProvider>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
