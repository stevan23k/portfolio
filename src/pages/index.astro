---
import "@/src/global.css";
import Layout from "../layouts/Layout.astro";

import Hero from "../components/Hero.astro";
import Header from "../components/Header.astro";
import Skills from "@/src/components/skills/Skills.astro";
import Projects from "@/src/components/projects/Projects.astro";

import { Button } from "@/components/ui/button";
import Education from "../components/Education.astro";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<script>
  import Lenis from "lenis";
  import { gsap } from "gsap";

  const lenis = new Lenis({ lerp: 0.12 });

  //get scroll value
  lenis.on("scroll", (e) => {
    console.log(e);
  });

  function raf(time) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }

  requestAnimationFrame(raf);

  const rect = document.querySelector("#reveal-rect");

  const winW = window.innerWidth;
  const winH = window.innerHeight;

  // Tamaño de la "ventana" cuando llega al centro (antes de expandirse)
  const midW = 220;
  const midH = 160;
  const midX = (winW - midW) / 2;
  const midY = (winH - midH) / 2;

  // Estado inicial: invisible, abajo, centrada horizontalmente
  gsap.set(rect, {
    attr: {
      x: winW / 2,
      y: winH,
      width: 0,
      height: 0,
      rx: 24,
    },
  });

  const tl = gsap.timeline();

  // Fase 1: sube desde abajo y aparece como ventana pequeña en el centro
  tl.to(rect, {
    attr: { x: midX, y: midY, width: midW, height: midH },
    rotation: 8,
    duration: 0.8,
    ease: "power4.out",
    filter: "blur(10px)",
  })
    // Fase 2: se expande hasta cubrir toda la pantalla
    .to(rect, {
      attr: { x: 0, y: 0, width: winW, height: winH, rx: 0 },
      rotation: 0,
      duration: 0.4,
      ease: "power4.inOut",
    })
    .call(() => {
      document.querySelector(".reveal-mask")?.remove();
    });
</script>

<Layout>
  <svg
    class="reveal-mask fixed inset-0 w-full h-full z-[100] pointer-events-none"
    width="100%"
    height="100%"
  >
    <defs>
      <mask id="window-mask">
        <rect x="0" y="0" width="100%" height="100%" fill="white" />
        <rect id="reveal-rect" fill="black" rx="24" />
      </mask>
    </defs>
    <rect
      x="0"
      y="0"
      width="100%"
      height="100%"
      fill="black"
      opacity="0.9"
      mask="url(#window-mask)"
    />
  </svg>

  <div class="page mx-auto px-10 max-w-250 min-w-auto w-full">
    <Header />
    <Hero />
    <Skills />
    <Projects />
    <Education />
    <Contact />
    <Footer />
  </div>
</Layout>
