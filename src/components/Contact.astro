---
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Separator } from "@/components/ui/separator";
import { Mail, MapPin, MessageCircle } from "lucide-react";
---

<section id="contact" class="pt-40">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
    <div class="flex flex-col gap-2">
      <h2 class="text-4xl font-bold">Contacto</h2>
      <p class="text-xl text-muted-foreground font-light">
        ¿Tenés un proyecto en mente? Hablemos.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <Card>
      <CardHeader>
        <CardTitle>
          <Mail size={20} />
          Email
        </CardTitle>
      </CardHeader>
      <CardContent>
        <a
          href="mailto:evanstrah12@gmail.com"
          class="text-muted-foreground hover:text-foreground hover:underline transition-colors break-all"
        >
          evanstrah12@gmail.com
        </a>
      </CardContent>
    </Card>

    <Card>
      <CardHeader>
        <CardTitle>
          <MapPin size={20} />
          Ubicación
        </CardTitle>
      </CardHeader>
      <CardContent>
        <span class="text-muted-foreground">
          Barranquilla, Colombia · UTC-5
        </span>
      </CardContent>
    </Card>

    <Card>
      <CardHeader>
        <CardTitle>
          <MessageCircle size={20} />
          Redes
        </CardTitle>
      </CardHeader>
      <CardContent>
        <div class="flex flex-row gap-4">
          <a
            href="https://github.com/stevan23k"
            target="_blank"
            rel="noreferrer"
            class="text-muted-foreground hover:text-foreground hover:underline transition-colors"
          >
            github.com/stevan23k
          </a>
          <a
            href="https://x.com/stevan23k"
            target="_blank"
            rel="noreferrer"
            class="text-muted-foreground hover:text-foreground hover:underline transition-colors"
          >
            x.com/stevan23k
          </a>
        </div>
      </CardContent>
    </Card>
  </div>
</section>
